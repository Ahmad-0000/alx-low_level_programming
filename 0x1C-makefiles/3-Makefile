CC = gcc
SRC = main.c school.c
OBJ = $(SRC:%.c=%.o)
NAME = school
RM = re

.PHONY := all clean oclean fclean re

all: ${NAME}

${NAME}: ${OBJ}
	${CC} ${OBJ} -o ${NAME}

%.o: %.c m.h
	${CC} -c -o $@ $<

clean:
	rm -f *~ ${NAME}

oclean:
	rm -f main.o school.o

fclean:
	rm -f *~ ${NAME}
	rm -f main.o school.o

re: ${OBJ}
	rm -f ${OBJ}
	${CC} -c -o main.o main.c
	${CC} -c -o school.o school.c
	${CC} ${OBJ} -o ${NAME}
